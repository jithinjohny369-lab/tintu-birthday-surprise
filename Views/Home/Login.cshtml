@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>For Tintu ❤️</title>

    <style>

        body {
            margin: 0;
            height: 100vh;
            background: linear-gradient(135deg,#ff6a88,#ff99ac);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            font-family: 'Segoe UI',sans-serif;
        }

        /* Floating hearts */

        .heart {
            position: absolute;
            color: white;
            font-size: 20px;
            animation: float 8s linear infinite;
            opacity: 0.7;
        }

        @@keyframes float {
            0%

        {
            transform: translateY(100vh) scale(0.5);
        }

        100% {
            transform: translateY(-10vh) scale(1.5);
        }

        }

        /* Glass card */

        .card {
            background: rgba(255,255,255,0.15);
            backdrop-filter: blur(15px);
            padding: 45px;
            border-radius: 25px;
            text-align: center;
            box-shadow: 0 15px 50px rgba(0,0,0,0.3);
            color: white;
            width: 320px;
            animation: fadeIn 1.2s ease;
        }

        @@keyframes fadeIn {
            from

        {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .title {
            font-size: 26px;
            margin-bottom: 10px;
        }

        .subtitle {
            opacity: 0.9;
            margin-bottom: 20px;
        }

        /* Input */

        input {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 30px;
            text-align: center;
            font-size: 16px;
            margin-bottom: 20px;
        }

        /* Button */

        button {
            padding: 14px 28px;
            border: none;
            border-radius: 30px;
            background: #ff4d6d;
            color: white;
            font-size: 16px;
            cursor: pointer;
            box-shadow: 0 0 20px #ff4d6d;
            transition: 0.3s;
        }

            button:hover {
                transform: scale(1.05);
                box-shadow: 0 0 30px #ff4d6d;
            }

        /* Shake animation */

        .shake {
            animation: shake 0.5s;
        }

        @@keyframes shake {
            0%,100%

        {
            transform: translateX(0);
        }

        25% {
            transform: translateX(-8px);
        }

        75% {
            transform: translateX(8px);
        }

        }

        /* Unlock effect */

        .unlock {
            animation: zoomOut 0.8s forwards;
        }

        @@keyframes zoomOut {
            to

        {
            transform: scale(2);
            opacity: 0;
        }

        }

        .error {
            margin-top: 15px;
            font-size: 14px;
        }

    </style>
</head>

<body>

    <!-- Floating hearts -->
    <script>
        for(let i=0;i<25;i++){
            let h=document.createElement("div");
            h.className="heart";
            h.innerHTML="❤️";
            h.style.left=Math.random()*100+"vw";
            h.style.fontSize=(15+Math.random()*25)+"px";
            h.style.animationDuration=(5+Math.random()*6)+"s";
            document.body.appendChild(h);
        }
    </script>

    <div id="card" class="card">

        <div class="title">🔐 For Tintu ❤️</div>
        <div class="subtitle">Enter our special date</div>

        <input id="password" type="password" placeholder="DDMMYYYY">

        <button onclick="unlock()">Unlock My Heart 💖</button>

        <div id="error" class="error"></div>

    </div>

    <script>

        function unlock(){

            const pass=document.getElementById("password").value;
            const card=document.getElementById("card");
            const error=document.getElementById("error");

            if(pass==="25092024"){ // change if you want

                error.innerText="Unlocked ❤️";

                card.classList.add("unlock");

                setTimeout(()=>{
                    window.location.href="/Home/Index";
                },800);

            }
            else{

                error.innerText="Wrong code 😢 Try again";
                card.classList.add("shake");

                setTimeout(()=>{
                    card.classList.remove("shake");
                },500);
            }
        }

    </script>

</body>
</html>