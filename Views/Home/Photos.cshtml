@{
    ViewData["Title"] = "Her Beautiful Moments";
}

<div class="gallery">

    <div class="slide active">
        <img src="~/images/her1.jpeg">
        <div class="caption">Your smile makes my world brighter ❤️</div>
        <button class="heart-btn" onclick="loveReaction()">❤️</button>
    </div>

    <div class="slide">
        <img src="~/images/her2.jpeg">
        <div class="caption">The most beautiful girl I know 💕</div>
        <button class="heart-btn" onclick="loveReaction()">❤️</button>
    </div>

    <div class="slide">
        <img src="~/images/her3.jpeg">
        <div class="caption">Every picture of you is my favorite 📸</div>
        <button class="heart-btn" onclick="loveReaction()">❤️</button>
    </div>

    <div class="slide">
        <img src="~/images/her4.jpeg">
        <div class="caption">Forever my happiness 🌸</div>
        <button class="heart-btn" onclick="loveReaction()">❤️</button>
    </div>

    <div class="slide">
        <img src="~/images/her5.jpeg">
        <div class="caption">Happy Birthday my love 🎂❤️</div>
        <button class="heart-btn" onclick="loveReaction()">❤️</button>
    </div>

</div>

<div class="controls">
    <button onclick="prevSlide()">❮</button>
    <button onclick="nextSlide()">❯</button>
</div>

<div class="next-page">
    <a href="/Home/Letter">
        <button class="letter-btn">Read My Letter 💌</button>
    </a>
</div>

<style>

    body {
        background: #000;
        font-family: Arial;
        text-align: center;
    }

    .gallery {
        position: relative;
        width: 90%;
        max-width: 400px;
        margin: auto;
        margin-top: 40px;
    }

    .slide {
        display: none;
    }

    .slide.active {
        display: block;
    }

    .slide img {
        width: 100%;
        border-radius: 20px;
    }

    .caption {
        color: white;
        margin-top: 10px;
        font-size: 18px;
    }

    .controls {
        margin-top: 20px;
    }

    .controls button {
        background: #ff4dd6;
        border: none;
        color: white;
        padding: 12px 18px;
        font-size: 18px;
        border-radius: 50%;
        cursor: pointer;
        margin: 10px;
    }

    .next-page button {
        margin-top: 30px;
        padding: 12px 25px;
        border: none;
        border-radius: 25px;
        background: #ff4dd6;
        color: white;
        font-size: 16px;
        cursor: pointer;
    }

    /* floating hearts */

    .heart {
        position: fixed;
        font-size: 20px;
        animation: floatUp 4s linear forwards;
    }

    @@keyframes floatUp {
        0% {
            transform: translateY(0);
            opacity: 1;
        }

        100% {
            transform: translateY(-700px);
            opacity: 0;
        }
    }

    .heart-btn {
        position: absolute;
        bottom: 15px;
        right: 15px;
        background: white;
        border: none;
        font-size: 24px;
        border-radius: 50%;
        width: 45px;
        height: 45px;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        transition: transform 0.2s;
    }

    .heart-btn:hover {
        transform: scale(1.2);
    }

    .reaction-heart {
        position: fixed;
        font-size: 25px;
        animation: floatUp 3s linear forwards;
    }

    .next-page {
        margin-top: 30px;
        text-align: center;
    }

    .letter-btn {
        padding: 14px 30px;
        border: none;
        border-radius: 30px;
        background: #ff4dd6;
        color: white;
        font-size: 18px;
        cursor: pointer;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        transition: 0.3s;
    }

    .letter-btn:hover {
        transform: scale(1.1);
    }

</style>

<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

<script>

    let slides = document.querySelectorAll(".slide");
    let index = 0;

    function showSlide(i){

        slides.forEach(s=>s.classList.remove("active"));

        if(i >= slides.length) index = 0;
        if(i < 0) index = slides.length-1;

        slides[index].classList.add("active");
    }

    function nextSlide(){
        index++;
        showSlide(index);
    }

    function prevSlide(){
        index--;
        showSlide(index);
    }

    // auto slider
    setInterval(()=>{
        index++;
        showSlide(index);
    },3500);


    // floating hearts

    function createHeart(){

        const heart = document.createElement("div");
        heart.className="heart";
        heart.innerHTML="❤️";

        heart.style.left=Math.random()*100+"vw";
        heart.style.bottom="0px";

        document.body.appendChild(heart);

        setTimeout(()=>{
            heart.remove();
        },4000);
    }

    setInterval(createHeart,800);


    // confetti on load

    window.onload = () => {
        confetti({
            particleCount:150,
            spread:80
        });
    };

        function loveReaction(){

        for(let i=0;i<10;i++){

            const heart = document.createElement("div");
            heart.className = "reaction-heart";
            heart.innerHTML = "❤️";

            heart.style.left = Math.random()*100 + "vw";
            heart.style.bottom = "0px";

            document.body.appendChild(heart);

            setTimeout(()=>{
                heart.remove();
            },3000);
        }
    }

</script>